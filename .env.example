# Copy these names into Vercel → Project → Settings → Environment Variables.
# NEVER put a real key in this file or commit one to GitHub.

# Google Gemini API key (free tier from Google AI Studio) — for screenshot
# analysis on the Vercel deployment. Server-side only. You may paste
# several keys here separated by commas — they are tried in order.
VISION_API_KEY=

# Optional extra Gemini keys (e.g. from a second Google account, for a
# separate free quota). Tried after VISION_API_KEY, in order.
VISION_API_KEY_2=
VISION_API_KEY_3=

# Optional: override the first Gemini model tried
# (default chain: gemini-3.8-flash → gemini-3.6-flash → gemini-3.5-flash-lite).
VISION_MODEL=

# Optional OpenAI fallback: used ONLY when every Gemini key/model fails.
# OpenAI has no free tier; gpt-4o-mini costs well under a cent per screenshot.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional lock: the SHA-256 hash the app stores for the admin passcode.
# When set, the analyze endpoint only accepts requests from the logged-in
# admin of this copy. Leave unset to skip the strict check.
ADMIN_PASSCODE_SHA256=
