# Copy these names into Vercel → Project → Settings → Environment Variables.
# NEVER put a real key in this file or commit one to GitHub.

# Google Gemini API key (free tier from Google AI Studio) — required for
# screenshot analysis on the Vercel deployment. Server-side only.
VISION_API_KEY=

# Optional: which Gemini model to use.
VISION_MODEL=gemini-3.8-flash

# Optional lock: the SHA-256 hash the app stores for the admin passcode.
# When set, the analyze endpoint only accepts requests from the logged-in
# admin of this copy. Leave unset to skip the strict check.
ADMIN_PASSCODE_SHA256=
